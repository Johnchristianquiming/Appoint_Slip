<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/itemstayslip"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="4dp"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAppSubject"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Subject Name"
                android:textColor="@color/midnightblue"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOverallStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#FFF3CD"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:text="WAITING"
                android:textColor="#856404"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAppDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Details"
            android:textColor="#555555"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="#EEEEEE" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTeacherStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Teacher: Waiting"
                android:textColor="#D97706"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSbmoStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="SBMO: Waiting"
                android:textColor="#D97706"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/returnMainScreen"
            android:layout_width="201dp"
            android:layout_height="40dp"
            android:background="@drawable/rectangle_lightblue_button"
            android:fontFamily="@font/abril_fatface"
            android:outlineAmbientShadowColor="#03A9F4"
            android:outlineSpotShadowColor="#03A9F4"
            android:shadowColor="#03A9F4"
            android:text="Return to Main Screen"
            android:textColorHighlight="#03A9F4"
            android:textColorHint="#03A9F4"
            android:textColorLink="#03A9F4"
            app:backgroundTint="#00A8FF"
            app:rippleColor="#03A9F4"
            app:strokeColor="#03A9F4" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
