<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/loginbg">

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="214dp"
        android:layout_height="226dp"
        android:layout_marginStart="98dp"
        android:layout_marginTop="62dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/mcslogotransparent" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="146dp"
        android:layout_height="39dp"
        android:layout_marginStart="132dp"
        android:layout_marginTop="297dp"
        android:fontFamily="@font/abril_fatface"
        android:outlineAmbientShadowColor="#03A9F4"
        android:outlineSpotShadowColor="#03A9F4"
        android:shadowColor="#03A9F4"
        android:text="WELCOME"
        android:textColor="#03A9F4"
        android:textColorHighlight="#03A9F4"
        android:textColorHint="#03A9F4"
        android:textColorLink="#03A9F4"
        android:textSize="28sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/welcomebutton"
        android:layout_width="123dp"
        android:layout_height="70dp"
        android:layout_marginStart="144dp"
        android:layout_marginTop="364dp"
        android:layout_marginBottom="297dp"
        android:fontFamily="@font/abril_fatface"
        android:outlineAmbientShadowColor="#03A9F4"
        android:outlineSpotShadowColor="#03A9F4"
        android:shadowColor="#03A9F4"
        android:text="ENTER"
        android:textColorHighlight="#03A9F4"
        android:textColorHint="#03A9F4"
        android:textColorLink="#03A9F4"
        android:background="@drawable/rectangle_lightblue_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:rippleColor="#03A9F4"
        app:strokeColor="#03A9F4"
        app:backgroundTint="#00A8FF"/>
</androidx.constraintlayout.widget.ConstraintLayout>