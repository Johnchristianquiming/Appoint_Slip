<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/itemportalstayslip"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvPortalSubject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Subject Name"
            android:textColor="@color/midnightblue"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPortalDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Details"
            android:textColor="#555555"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvPortalStatusInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Teacher: Waiting | SBMO: Waiting"
            android:textColor="#D97706"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnApproveSlip"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:text="Approve Slip"
            android:textColor="@android:color/white"
            android:background="@drawable/rectangle_lightblue_button"
            android:fontFamily="@font/abril_fatface"
            android:outlineAmbientShadowColor="#03A9F4"
            android:outlineSpotShadowColor="#03A9F4"
            android:shadowColor="#03A9F4"
            android:textColorHighlight="#03A9F4"
            android:textColorHint="#03A9F4"
            android:textColorLink="#03A9F4"
            app:backgroundTint="#00A8FF"
            app:rippleColor="#03A9F4"
            app:strokeColor="#03A9F4"/>

        <Button
            android:id="@+id/returntoMainScreen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Return to Main Screen"
            android:background="@drawable/rectangle_lightblue_button"
            android:fontFamily="@font/abril_fatface"
            android:outlineAmbientShadowColor="#03A9F4"
            android:outlineSpotShadowColor="#03A9F4"
            android:shadowColor="#03A9F4"
            android:textColorHighlight="#03A9F4"
            android:textColorHint="#03A9F4"
            android:textColorLink="#03A9F4"
            app:backgroundTint="#00A8FF"
            app:rippleColor="#03A9F4"
            app:strokeColor="#03A9F4"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>